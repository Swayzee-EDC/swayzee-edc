{
  "name": "tella",
  "version": "0.0.1",
  "description": "Simple, Light, Responsive",
  "main": "index.js",
  "repository": "https://github.com/opera7133/tella",
  "author": "wamo <ainznino@pm.me>",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "concurrently npm:watch:*",
    "start:tina": "npx tinacms dev -c 'hugo server -D -p 1313'",
    "watch:tw": "tailwindcss -i ./themes/tella/assets/css/main.css -o ./themes/tella/assets/css/style.css --watch",
    "watch:hugo": "hugo server",
    "build": "tailwindcss -i ./themes/tella/assets/css/main.css -o ./themes/tella/assets/css/style.css && hugo --minify"
  },
  "devDependencies": {
    "@stackbit/cms-git": "^0.0.55",
    "@stackbit/types": "^2.0.5",
    "@tailwindcss/typography": "^0.5.20",
    "@tinacms/cli": "^4.0.1",
    "@types/node": "^24.19.1",
    "autoprefixer": "^10.4.7",
    "concurrently": "^8.0.1",
    "postcss": "^8.4.14",
    "postcss-cli": "^10.0.0",
    "tailwindcss": "^3.4.19"
  },
  "dependencies": {
    "js-beautify": "^1.15.4",
    "tinacms": "^3.14.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.14.54": true,
    "better-sqlite3@12.11.1": true,
    "fsevents@2.3.3": true,
    "core-js@3.50.0": true
  }
}
